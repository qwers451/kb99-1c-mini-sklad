// Для отдельной тестовой базы: серверный общий модуль с вызовом ВыполнитьПроверку().
// Проверка создаёт тестовые товары и документы; не запускать в рабочей базе.

Функция ПроверитьОстаток(Товар, Ожидается)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
        |ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(, Товар = &Товар) КАК Остатки");
    Запрос.УстановитьПараметр("Товар", Товар);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Если Выборка.Количество <> Ожидается Тогда
        ВызватьИсключение "Ожидался остаток " + Строка(Ожидается)
            + ", получен " + Строка(Выборка.Количество);
    КонецЕсли;
    Возврат Истина;
КонецФункции

Функция НовыйДокумент(Имя, Товар, Количество, Контрагент)
    Документ = Документы[Имя].СоздатьДокумент();
    Документ.Дата = ТекущаяДата();
    Документ.Контрагент = Контрагент;
    СтрокаТовара = Документ.Товары.Добавить();
    СтрокаТовара.Товар = Товар;
    СтрокаТовара.Количество = Количество;
    Возврат Документ;
КонецФункции

Процедура ПроверитьОтказ(Документ)
    БылОтказ = Ложь;
    Попытка
        Документ.Записать(РежимЗаписиДокумента.Проведение);
    Исключение
        БылОтказ = Истина;
    КонецПопытки;
    Если Не БылОтказ Тогда
        ВызватьИсключение "Реализация сверх остатка проведена";
    КонецЕсли;
КонецПроцедуры

Функция ВыполнитьПроверку() Экспорт
    Попытка
        Товар = Справочники.Товары.СоздатьЭлемент();
        Товар.Наименование = "Контроль остатка " + Строка(Новый УникальныйИдентификатор);
        Товар.Записать();
        Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
        Контрагент.Наименование = "Тестовый контрагент";
        Контрагент.Записать();
        Приход = НовыйДокумент("Поступление", Товар.Ссылка, 10, Контрагент.Ссылка);
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        ПроверитьОстаток(Товар.Ссылка, 10);

        ЛишнийРасход = НовыйДокумент("Реализация", Товар.Ссылка, 11, Контрагент.Ссылка);
        ПроверитьОтказ(ЛишнийРасход);
        ПроверитьОстаток(Товар.Ссылка, 10);

        ЛишнийРасход.Товары[0].Количество = 6;
        СтрокаТовара = ЛишнийРасход.Товары.Добавить();
        СтрокаТовара.Товар = Товар.Ссылка;
        СтрокаТовара.Количество = 5;
        ПроверитьОтказ(ЛишнийРасход);
        ПроверитьОстаток(Товар.Ссылка, 10);

        Расход = НовыйДокумент("Реализация", Товар.Ссылка, 3, Контрагент.Ссылка);
        Расход.Записать(РежимЗаписиДокумента.Проведение);
        ПроверитьОстаток(Товар.Ссылка, 7);
        Расход.Записать(РежимЗаписиДокумента.Проведение);
        ПроверитьОстаток(Товар.Ссылка, 7);
        Расход.Товары[0].Количество = 8;
        Расход.Записать(РежимЗаписиДокумента.Проведение);
        ПроверитьОстаток(Товар.Ссылка, 2);

        Расход.Товары[0].Количество = 11;
        ПроверитьОтказ(Расход);
        ПроверитьОстаток(Товар.Ссылка, 2);
        СохраненныйРасход = Расход.Ссылка.ПолучитьОбъект();
        Если Не СохраненныйРасход.Проведен Или СохраненныйРасход.Товары[0].Количество <> 8 Тогда
            ВызватьИсключение "Отказ повредил ранее проведённый документ";
        КонецЕсли;

        Расход.Товары[0].Количество = 10;
        Расход.Записать(РежимЗаписиДокумента.Проведение);
        ПроверитьОстаток(Товар.Ссылка, 0);
        Расход.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        ПроверитьОстаток(Товар.Ссылка, 10);
        Приход.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        ПроверитьОстаток(Товар.Ссылка, 0);
        Возврат "PASS: запрет 11 при остатке 10; дубль 6+5; 10-3=7; повторное проведение; изменение 3→8; отказ 8→11 сохраняет движения; точное списание; отмена";
    Исключение
        Возврат "FAIL: " + ОписаниеОшибки();
    КонецПопытки;
КонецФункции
