// Для отдельной тестовой базы: серверный общий модуль с вызовом Запустить().
// Создаёт демо-данные за октябрь 2026, сверяет остатки на даты, формирует СКД-отчёт и накладную.
// Не запускать в рабочей базе.


Процедура Л(Лог, Текст)
	Лог.Добавить(Текст);
КонецПроцедуры

Функция Элемент(Менеджер, Наименование)
	Объект = Менеджер.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция Документ(Лог, Имя, Дата, Контрагент, Строки)
	Док = Документы[Имя].СоздатьДокумент();
	Док.Дата = Дата;
	Док.Контрагент = Контрагент;
	Для Каждого С Из Строки Цикл
		Стр = Док.Товары.Добавить();
		Стр.Товар = С[0];
		Стр.Количество = С[1];
		Если С.Количество() > 2 Тогда
			Стр.Цена = С[2];
		КонецЕсли;
	КонецЦикла;
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
		Л(Лог, "Проведён: " + Имя + " от " + Формат(Дата, "ДФ=dd.MM.yyyy"));
	Исключение
		Л(Лог, "Отказ проведения: " + Имя + " от " + Формат(Дата, "ДФ=dd.MM.yyyy") + " — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Док.Ссылка;
КонецФункции

Функция Ст(Товар, Количество, Цена = Неопределено)
	М = Новый Массив;
	М.Добавить(Товар); М.Добавить(Количество);
	Если Цена <> Неопределено Тогда М.Добавить(Цена); КонецЕсли;
	Возврат М;
КонецФункции

Функция Мас(А, Б = Неопределено, В = Неопределено)
	М = Новый Массив;
	М.Добавить(А);
	Если Б <> Неопределено Тогда М.Добавить(Б); КонецЕсли;
	Если В <> Неопределено Тогда М.Добавить(В); КонецЕсли;
	Возврат М;
КонецФункции

Функция Остаток(Товар, Дата)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(О.КоличествоОстаток), 0) КАК К
		|ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Дата, Товар = &Товар) КАК О");
	Запрос.УстановитьПараметр("Дата", Новый Граница(Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Товар", Товар);
	В = Запрос.Выполнить().Выбрать();
	В.Следующий();
	Возврат В.К;
КонецФункции

Функция ТекстТабДока(Т)
	Строки = Новый Массив;
	Для Р = 1 По Т.ВысотаТаблицы Цикл
		Ячейки = Новый Массив;
		Для К = 1 По Т.ШиринаТаблицы Цикл
			Текст = СокрЛП(Т.Область(Р, К, Р, К).Текст);
			Если Текст <> "" Тогда
				Ячейки.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить("    " + СтрСоединить(Ячейки, " | "));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция Запустить() Экспорт
	Лог = Новый Массив;

	Молоко = Элемент(Справочники.Товары, "Молоко 3,2% 1 л");
	Сыр = Элемент(Справочники.Товары, "Сыр Российский, кг");
	Масло = Элемент(Справочники.Товары, "Масло сливочное 82,5%");
	Поставщик = Элемент(Справочники.Контрагенты, "ООО «Молочный завод»");
	Покупатель1 = Элемент(Справочники.Контрагенты, "ИП Иванов И.И.");
	Покупатель2 = Элемент(Справочники.Контрагенты, "ООО «Вектор»");

	Документ(Лог, "Поступление", Дата(2026, 10, 1, 9, 0, 0), Поставщик, Мас(Ст(Молоко, 100), Ст(Сыр, 50), Ст(Масло, 40)));
	Документ(Лог, "Реализация", Дата(2026, 10, 10, 12, 0, 0), Покупатель1, Мас(Ст(Молоко, 30, 89.90), Ст(Сыр, 10, 650)));
	Документ(Лог, "Поступление", Дата(2026, 10, 15, 9, 0, 0), Поставщик, Мас(Ст(Масло, 20)));
	Последняя = Документ(Лог, "Реализация", Дата(2026, 10, 20, 15, 0, 0), Покупатель2, Мас(Ст(Молоко, 50, 89.90), Ст(Масло, 35, 240)));
	Документ(Лог, "Реализация", Дата(2026, 10, 25, 11, 0, 0), Покупатель1, Мас(Ст(Сыр, 100, 650)));

	Л(Лог, "");
	Л(Лог, "Сверка остатков на дату (факт / ожидание):");
	Даты = Новый Массив;
	Даты.Добавить(Дата(2026, 9, 30, 23, 59, 59));
	Даты.Добавить(Дата(2026, 10, 5, 23, 59, 59));
	Даты.Добавить(Дата(2026, 10, 12, 23, 59, 59));
	Даты.Добавить(Дата(2026, 10, 18, 23, 59, 59));
	Даты.Добавить(Дата(2026, 10, 31, 23, 59, 59));
	Ожидание = Новый Соответствие;
	Ожидание.Вставить(Молоко, СтрРазделить("0,100,70,70,20", ","));
	Ожидание.Вставить(Сыр, СтрРазделить("0,50,40,40,40", ","));
	Ожидание.Вставить(Масло, СтрРазделить("0,40,40,60,25", ","));
	Ошибок = 0;
	Для Каждого Товар Из Мас(Молоко, Сыр, Масло) Цикл
		Текст = Строка(Товар) + ":";
		Для Н = 0 По Даты.ВГраница() Цикл
			Факт = Остаток(Товар, Даты[Н]);
			Ждём = Число(Ожидание[Товар][Н]);
			Текст = Текст + " " + Формат(Даты[Н], "ДФ=dd.MM") + "=" + Формат(Факт, "ЧН=0; ЧГ=0") + "/" + Ждём;
			Если Факт <> Ждём Тогда Ошибок = Ошибок + 1; КонецЕсли;
		КонецЦикла;
		Л(Лог, Текст);
	КонецЦикла;
	Л(Лог, ?(Ошибок = 0, "PASS: остатки на все даты совпали", "FAIL: расхождений " + Ошибок));

	// Отчёт СКД за октябрь
	Схема = Отчеты.ОборотыПоТоварам.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Настройки = Схема.НастройкиПоУмолчанию;
	Период = Новый СтандартныйПериод(Дата(2026, 10, 1), Дата(2026, 10, 31, 23, 59, 59));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Период);
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = Компоновщик.Выполнить(Схема, Настройки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);
	ТабДок = Новый ТабличныйДокумент;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Вывод.УстановитьДокумент(ТабДок);
	Вывод.Вывести(Процессор);
	Л(Лог, "");
	Л(Лог, "Отчёт «Обороты по товарам» за октябрь 2026 (содержимое табличного документа):");
	Л(Лог, ТекстТабДока(ТабДок));

	Попытка
		ТабПечать = Новый ТабличныйДокумент;
		Документы.Реализация.ПечатьНакладной(ТабПечать, Последняя);
		Л(Лог, "");
		Л(Лог, "Печатная форма «Товарная накладная»:");
		Л(Лог, ТекстТабДока(ТабПечать));
		Л(Лог, "PASS: печатная форма сформирована");
	Исключение
		Л(Лог, "Печать: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат СтрСоединить(Лог, Символы.ПС);
КонецФункции
