		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиИОбороты.Товар КАК Товар,
	ОстаткиИОбороты.КоличествоНачальныйОстаток КАК НачальныйОстаток,
	ОстаткиИОбороты.КоличествоПриход КАК Приход,
	ОстаткиИОбороты.КоличествоРасход КАК Расход,
	ОстаткиИОбороты.КоличествоКонечныйОстаток КАК КонечныйОстаток,
	ЕСТЬNULL(Продажи.Сумма, 0) КАК СуммаПродаж
ИЗ
	РегистрНакопления.ОстаткиТоваров.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , ) КАК ОстаткиИОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ПродажиОбороты.Товар КАК Товар,
			СУММА(ПродажиОбороты.СуммаОборот) КАК Сумма
		ИЗ
			РегистрНакопления.ПродажиТоваров.Обороты(&amp;НачалоПериода, &amp;КонецПериода, , ) КАК ПродажиОбороты
		СГРУППИРОВАТЬ ПО
			ПродажиОбороты.Товар) КАК Продажи
		ПО ОстаткиИОбороты.Товар = Продажи.Товар</query>
