#Область ПрограммныйИнтерфейс

// Заполняет табличный документ печатной формой «Товарная накладная».
//
// Параметры:
//  ТабДок - ТабличныйДокумент - заполняемый документ.
//  Ссылка - ДокументСсылка.Реализация - печатаемый документ.
//
Процедура ПечатьНакладной(ТабДок, Ссылка) Экспорт

	Макет = Документы.Реализация.ПолучитьМакет("ТоварнаяНакладная");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Реализация.Номер КАК Номер,
		| Реализация.Дата КАК Дата,
		| Реализация.Контрагент КАК Контрагент,
		| Реализация.Товары.(
		|     НомерСтроки КАК НомерСтроки,
		|     Товар КАК Товар,
		|     Количество КАК Количество,
		|     Цена КАК Цена,
		|     Сумма КАК Сумма) КАК Товары
		|ИЗ
		| Документ.Реализация КАК Реализация
		|ГДЕ
		| Реализация.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Шапка = Запрос.Выполнить().Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	ТабДок.Очистить();
	ТабДок.КлючПараметровПечати = "ПараметрыПечати_Реализация_ТоварнаяНакладная";

	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Номер = Шапка.Номер;
	Область.Параметры.Дата = Формат(Шапка.Дата, "ДЛФ=D");
	Область.Параметры.Контрагент = Шапка.Контрагент;
	ТабДок.Вывести(Область);

	ТабДок.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));

	ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
	ИтогКоличество = 0;
	ИтогСумма = 0;
	Строки = Шапка.Товары.Выбрать();
	Пока Строки.Следующий() Цикл
		ОбластьСтроки.Параметры.Заполнить(Строки);
		ТабДок.Вывести(ОбластьСтроки);
		ИтогКоличество = ИтогКоличество + Строки.Количество;
		ИтогСумма = ИтогСумма + Строки.Сумма;
	КонецЦикла;

	Область = Макет.ПолучитьОбласть("Подвал");
	Область.Параметры.ИтогКоличество = ИтогКоличество;
	Область.Параметры.ИтогСумма = ИтогСумма;
	ТабДок.Вывести(Область);

КонецПроцедуры

#КонецОбласти
