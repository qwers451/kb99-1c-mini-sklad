#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Для Каждого СтрокаТоваров Из Товары Цикл
		СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.БлокироватьДляИзменения = Истина;
	Движения.ПродажиТоваров.Записывать = Истина;

	Для Каждого СтрокаТоваров Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТоваров.Товар;
		Движение.Количество = СтрокаТоваров.Количество;

		Движение = Движения.ПродажиТоваров.Добавить();
		Движение.Период = Дата;
		Движение.Товар = СтрокаТоваров.Товар;
		Движение.Контрагент = Контрагент;
		Движение.Количество = СтрокаТоваров.Количество;
		Движение.Сумма = СтрокаТоваров.Сумма;
	КонецЦикла;

	// Запись выполняется в транзакции проведения. При отказе движения откатятся.
	Движения.ОстаткиТоваров.Записать();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Остатки.Товар КАК Товар,
		| Остатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		| РегистрНакопления.ОстаткиТоваров.Остатки(,
		|     Товар В (&Товары)) КАК Остатки
		|ГДЕ
		| Остатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Товары", Товары.Выгрузить().ВыгрузитьКолонку("Товар"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отказ = Истина;

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Недостаточно товара «" + Строка(Выборка.Товар)
			+ "». Не хватает " + Строка(-Выборка.КоличествоОстаток)
			+ " шт. Проведение реализации отменено.";
		Сообщение.Поле = "Товары";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
